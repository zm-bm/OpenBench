[Unit]
Description=OpenBench chess testing server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/tools/OpenBench
EnvironmentFile=%h/.config/openbench/openbench.env
Environment=PYTHONPATH=%h/code/tools/OpenBench/Deploy:%h/code/tools/OpenBench
ExecStart=%h/code/tools/OpenBench/.venv/bin/gunicorn OpenSite.wsgi:application --bind 127.0.0.1:8000 --bind ${OPENBENCH_BIND} --workers 1 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=120s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=1G

[Install]
WantedBy=default.target

