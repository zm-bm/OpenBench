DJANGO_SETTINGS_MODULE=openbench_settings
DJANGO_SECRET_KEY=replace-with-a-random-secret
OPENBENCH_ALLOWED_HOSTS=127.0.0.1,localhost,server.example.test
# Set this only when HTTPS terminates at a trusted reverse proxy.
# OPENBENCH_PUBLIC_HOST=server.example.test
OPENBENCH_BIND=127.0.0.1:8000
OPENBENCH_SERVER=http://127.0.0.1:8000
OPENBENCH_USERNAME=replace-with-an-enabled-user
OPENBENCH_PASSWORD=replace-with-the-user-password
OPENBENCH_WORKER_THREADS=1
OPENBENCH_WORKER_SOCKETS=1
OPENBENCH_WORKER_IDENTITY=worker-hostname
OPENBENCH_WORKER_FOCUS=Latrunculi
